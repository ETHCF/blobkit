{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declarationMap": true,
    "types": ["node", "jest"],
    "skipLibCheck": true,
    // Resolve @blobkit/sdk from node_modules (the published package this
    // server depends on) instead of the workspace source mapped in the base config.
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "dist", "../sdk/src/**/*"]
}
